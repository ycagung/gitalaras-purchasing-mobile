{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Dev)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=ENV=dev"
      ]
    },
    {
      "name": "Flutter (Staging)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=ENV=staging"
      ]
    },
    {
      "name": "Flutter (Production)",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=ENV=production"
      ]
    },
    {
      "name": "Flutter (Profile - Staging)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": [
        "--dart-define=ENV=staging"
      ]
    },
    {
      "name": "Flutter (Release - Staging)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "args": [
        "--dart-define=ENV=staging"
      ]
    }
  ]
}

